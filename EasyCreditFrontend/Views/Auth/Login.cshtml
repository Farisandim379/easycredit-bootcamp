@model LoginViewModel
@{
    ViewData["Title"] = "Masuk";
}

<div class="login-wrap">
    <div class="card login-card">
        <div class="brand d-flex align-items-center gap-2 mb-2">
            <span class="brand-mark">EC</span>
            <div class="brand-text">
                <strong>EasyCredit</strong>
                <small>MVC Frontend</small>
            </div>
        </div>

        <h1 class="page-title" style="font-size:26px;">Masuk ke EasyCredit</h1>
        <p class="mb-2" style="font-size:14px; opacity:.85;">Gunakan akun yang terdaftar di EasyCredit API.</p>

        <form asp-controller="Auth" asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3 p-2"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" id="loginEmail" class="form-control" placeholder="admin@easycredit.test" autocomplete="username" />
                <span asp-validation-for="Email" class="text-danger font-bold text-sm"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" id="loginPassword" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger font-bold text-sm"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 mt-2">Masuk</button>
        </form>

        <div class="mt-4 pt-3 border-top" style="border-color: var(--ink) !important;">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <strong style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em;">Akun Demo Cepat:</strong>
            </div>
            <div class="d-flex flex-column gap-2" style="font-size: 12px;">
                <button type="button" class="btn btn-sm btn-action text-start p-2 js-fill-demo" data-email="admin@easycredit.test" data-role="admin123">
                    <strong>ADMIN:</strong> admin@easycredit.test <span class="badge bg-dark ms-1">admin123</span>
                </button>
                <button type="button" class="btn btn-sm btn-action text-start p-2 js-fill-demo" data-email="staff@easycredit.test" data-role="staff123">
                    <strong>STAFF:</strong> staff@easycredit.test <span class="badge bg-secondary ms-1">staff123</span>
                </button>
            </div>
        </div>
    </div>

    <div class="footer text-center mt-3" style="border:none !important;">
        <span>&copy; @DateTime.Now.Year EasyCredit — Bootcamp .NET Batch 19</span>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            $('.js-fill-demo').on('click', function () {
                var email = $(this).data('email');
                var pass = $(this).data('role');
                $('#loginEmail').val(email);
                $('#loginPassword').val(pass);
            });
        });
    </script>
}
