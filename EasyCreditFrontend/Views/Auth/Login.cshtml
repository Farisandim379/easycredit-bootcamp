@model LoginViewModel
@{
    ViewData["Title"] = "Masuk";
}

<div class="login-wrap">
    <div class="card login-card">
        <div class="brand d-flex align-items-center gap-2 mb-2">
            <span class="brand-mark">EC</span>
            <div class="brand-text">
                <strong>EasyCredit</strong>
                <small>MVC Frontend</small>
            </div>
        </div>

        <h1 class="page-title" style="font-size:26px;">Masuk ke EasyCredit</h1>
        <p class="mb-2" style="font-size:14px; opacity:.85;">Gunakan akun yang terdaftar di EasyCredit API.</p>

        <form asp-controller="Auth" asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3 p-2"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" placeholder="admin@mail.com" autocomplete="username" />
                <span asp-validation-for="Email" class="text-danger font-bold text-sm"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger font-bold text-sm"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 mt-2">Masuk</button>
        </form>
    </div>

    <div class="footer text-center mt-3" style="border:none !important;">
        <span>&copy; @DateTime.Now.Year EasyCredit — Bootcamp .NET Batch 19</span>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
