@model CreateApplicationViewModel
@{
    ViewData["Title"] = "Ajukan Pinjaman Kredit";
}

<div class="d-flex flex-column gap-1 mb-4">
    <div class="crumbs mb-1">
        <a asp-controller="Home" asp-action="Index">Dashboard</a>
        <span>/</span>
        <a asp-action="Index">Pengajuan</a>
        <span>/</span>
        <span>Ajukan Pinjaman</span>
    </div>
    <h2>Buat Pengajuan Pinjaman</h2>
    <p class="mb-0" style="opacity: .75; font-size: 13px;">Pilih nasabah, tentukan nominal serta tenor, dan lihat simulasi cicilan sebelum menyimpan.</p>
</div>

<div class="row g-4">
    <!-- Form Card -->
    <div class="col-lg-6">
        <div class="card panel p-4 h-100">
            <h3 class="mb-3" style="font-size: 18px; border-bottom: 2px solid var(--ink); padding-bottom: 8px;">Form Pengajuan</h3>

            <form asp-action="Create" method="post" id="formCreateApp">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="CustomerId" class="form-label font-bold"></label>
                    <select asp-for="CustomerId" asp-items="@ViewBag.CustomerList" class="form-select form-control" id="selectCustomer">
                        <option value="">-- Pilih Nasabah --</option>
                    </select>
                    <span asp-validation-for="CustomerId" class="text-danger text-sm font-bold"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Amount" class="form-label font-bold"></label>
                    <div class="input-group">
                        <span class="input-group-text font-bold">Rp</span>
                        <input type="text"
                               id="displayAmount"
                               class="form-control font-bold"
                               placeholder="50.000.000"
                               autocomplete="off"
                               inputmode="numeric"
                               style="font-size: 16px;" />
                        <input type="hidden" asp-for="Amount" id="inputAmount" />
                    </div>

                    <div class="d-flex flex-wrap justify-content-between align-items-center mt-2 gap-1">
                        <div class="d-flex gap-1 flex-wrap">
                            <button type="button" class="btn btn-sm js-quick-amount" data-amount="5000000" style="padding: 2px 8px; font-size: 11px;">5 Juta</button>
                            <button type="button" class="btn btn-sm js-quick-amount" data-amount="10000000" style="padding: 2px 8px; font-size: 11px;">10 Juta</button>
                            <button type="button" class="btn btn-sm js-quick-amount" data-amount="25000000" style="padding: 2px 8px; font-size: 11px;">25 Juta</button>
                            <button type="button" class="btn btn-sm js-quick-amount" data-amount="50000000" style="padding: 2px 8px; font-size: 11px; background: var(--orange); color: var(--cream);">50 Juta (Maks)</button>
                        </div>
                        <span id="amountInWords" class="chip chip-sm" style="font-size: 11px;">Rp 50.000.000</span>
                    </div>

                    <small class="d-block mt-1" style="font-size: 12px; opacity: .75;">Batas pinjaman: Rp 1.000.000 s/d Rp 50.000.000</small>
                    <span asp-validation-for="Amount" class="text-danger text-sm font-bold d-block mt-1"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="TenorMonths" class="form-label font-bold"></label>
                    <div class="d-flex gap-2">
                        <select asp-for="TenorMonths" id="selectTenor" class="form-select form-control">
                            <option value="6">6 Bulan</option>
                            <option value="12" selected>12 Bulan (1 Tahun)</option>
                            <option value="24">24 Bulan (2 Tahun)</option>
                            <option value="36">36 Bulan (3 Tahun)</option>
                        </select>
                        <button type="button" id="btnCalculate" class="btn btn-action text-nowrap">
                            ⚙ Hitung
                        </button>
                    </div>
                    <span asp-validation-for="TenorMonths" class="text-danger text-sm font-bold"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center gap-2 pt-3" style="border-top: 2px solid var(--ink);">
                    <a class="btn btn-action" asp-action="Index">Batal</a>
                    <button type="submit" id="btnSubmit" class="btn btn-primary">
                        Ajukan Pinjaman
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Preview Cicilan Card -->
    <div class="col-lg-6">
        <div class="card panel p-4 h-100" id="previewContainer">
            <div class="d-flex justify-content-between align-items-center mb-3" style="border-bottom: 2px solid var(--ink); padding-bottom: 8px;">
                <h3 class="mb-0" style="font-size: 18px;">Simulasi Cicilan (Preview)</h3>
                <span class="chip chip-sm" id="previewBadge" style="font-size: 11px;">Belum Dihitung</span>
            </div>

            <div id="previewEmptyState" class="py-5 text-center">
                <div style="font-size: 32px; margin-bottom: 8px;">📊</div>
                <h4 style="font-size: 16px;">Belum Ada Simulasi</h4>
                <p style="font-size: 13px; opacity: .75;" class="mb-3">
                    Klik tombol <strong>Hitung</strong> untuk melihat rincian cicilan dan tanggal jatuh tempo tanpa menyimpan ke database.
                </p>
                <button type="button" class="btn btn-sm" onclick="$('#btnCalculate').trigger('click');">
                    Hitung Sekarang
                </button>
            </div>

            <div id="previewResult" style="display: none;">
                <div class="d-flex justify-content-between align-items-center p-3 mb-3" style="background: var(--paper); border: 2px solid var(--ink);">
                    <div>
                        <div style="font-size: 11px; text-transform: uppercase; font-weight: 700; opacity: .75;">Estimasi Cicilan / Bulan</div>
                        <div id="previewMonthlyAmount" style="font-size: 20px; font-weight: 900; color: var(--ink);">Rp 0</div>
                    </div>
                    <div class="text-end">
                        <div style="font-size: 11px; text-transform: uppercase; font-weight: 700; opacity: .75;">Total Tenor</div>
                        <div id="previewTotalTenor" style="font-size: 18px; font-weight: 800;">12 Bulan</div>
                    </div>
                </div>

                <div class="table-wrap" style="max-height: 340px; overflow-y: auto; border: 2px solid var(--ink);">
                    <table class="table mb-0">
                        <thead style="position: sticky; top: 0; background: var(--cream); z-index: 1;">
                            <tr>
                                <th style="width: 50px;">Ke</th>
                                <th>Jatuh Tempo</th>
                                <th class="num">Nominal</th>
                                <th class="num">Status</th>
                            </tr>
                        </thead>
                        <tbody id="previewTableBody">
                        </tbody>
                    </table>
                </div>
                <small class="d-block mt-2 text-muted" style="font-size: 11px;">
                    * Data simulasi dihitung melalui Stored Procedure Oracle (tidak disimpan ke database sebelum form dikirim).
                </small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(function () {
            function formatRupiah(number) {
                return 'Rp ' + Number(number).toLocaleString('id-ID');
            }

            function formatDate(dateStr) {
                var d = new Date(dateStr);
                return d.toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' });
            }

            function updateAmount(val) {
                var rawDigits = String(val).replace(/\D/g, '');
                var num = rawDigits ? parseInt(rawDigits, 10) : 0;

                $('#inputAmount').val(num > 0 ? num : '');

                if (num > 0) {
                    $('#displayAmount').val(Number(num).toLocaleString('id-ID'));
                    $('#amountInWords').show();

                    if (num > 50000000) {
                        $('#amountInWords')
                            .removeClass('chip-sm')
                            .addClass('badge badge-rejected')
                            .text('Maksimal Rp 50.000.000');
                    } else if (num < 1000000) {
                        $('#amountInWords')
                            .removeClass('chip-sm')
                            .addClass('badge badge-rejected')
                            .text('Minimal Rp 1.000.000');
                    } else {
                        $('#amountInWords')
                            .removeClass('badge badge-rejected')
                            .addClass('chip chip-sm')
                            .text(formatRupiah(num));
                    }
                } else {
                    $('#displayAmount').val('');
                    $('#amountInWords').hide();
                }
            }

            // Real-time formatting as user types
            $('#displayAmount').on('input', function () {
                var raw = $(this).val();
                updateAmount(raw);

                var num = parseInt(String(raw).replace(/\D/g, ''), 10);
                if (num >= 1000000 && num <= 50000000) {
                    $('#btnCalculate').trigger('click');
                }
            });

            // Quick preset chips (5 Juta, 10 Juta, 25 Juta, 50 Juta)
            $('.js-quick-amount').on('click', function () {
                var amt = $(this).data('amount');
                updateAmount(amt);
                $('#btnCalculate').trigger('click');
            });

            // Tenor change auto-trigger
            $('#selectTenor').on('change', function () {
                $('#btnCalculate').trigger('click');
            });

            $('#btnCalculate').on('click', function () {
                var $btn = $(this);
                var amount = parseFloat($('#inputAmount').val());
                var tenor = parseInt($('#selectTenor').val(), 10);

                if (!amount || amount < 1000000 || amount > 50000000) {
                    EC.toast('error', 'Nominal harus antara Rp 1.000.000 dan Rp 50.000.000.', 'Validasi');
                    $('#displayAmount').focus();
                    return;
                }

                if (![6, 12, 24, 36].includes(tenor)) {
                    EC.toast('error', 'Tenor harus 6, 12, 24, atau 36 bulan.', 'Validasi');
                    $('#selectTenor').focus();
                    return;
                }

                $btn.prop('disabled', true).text('Menghitung...');

                $.ajax({
                    url: '@Url.Action("PreviewInstallment", "CreditApplications")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ amount: amount, tenorMonths: tenor }),
                    headers: {
                        'RequestVerificationToken': EC.token()
                    },
                    success: function (res) {
                        $btn.prop('disabled', false).html('⚙ Hitung');

                        if (res.status && res.data && res.data.length > 0) {
                            var items = res.data;
                            var tbody = $('#previewTableBody');
                            tbody.empty();

                            items.forEach(function (item) {
                                tbody.append(
                                    '<tr>' +
                                    '  <td class="font-bold">#' + item.installmentNo + '</td>' +
                                    '  <td>' + formatDate(item.dueDate) + '</td>' +
                                    '  <td class="num font-bold">' + formatRupiah(item.installmentAmount) + '</td>' +
                                    '  <td class="num"><span class="badge badge-pending" style="font-size: 10px;">' + (item.status || 'UNPAID') + '</span></td>' +
                                    '</tr>'
                                );
                            });

                            var monthly = items[0].installmentAmount;
                            $('#previewMonthlyAmount').text(formatRupiah(monthly));
                            $('#previewTotalTenor').text(tenor + ' Bulan');
                            $('#previewBadge').removeClass('chip-sm').addClass('chip-orange').text(tenor + ' Cicilan');

                            $('#previewEmptyState').hide();
                            $('#previewResult').fadeIn(200);
                        } else {
                            EC.toast('error', res.message || 'Gagal menghitung simulasi cicilan.', 'Gagal');
                        }
                    },
                    error: function (xhr) {
                        $btn.prop('disabled', false).html('⚙ Hitung');
                        var msg = (xhr.responseJSON && xhr.responseJSON.message) ? xhr.responseJSON.message : 'Terjadi kesalahan sistem.';
                        EC.toast('error', msg, 'Gagal');
                    }
                });
            });

            // Initialize on page load with 50.000.000
            var initialAmt = $('#inputAmount').val() || 50000000;
            updateAmount(initialAmt);
            $('#btnCalculate').trigger('click');
        });
    </script>
}
