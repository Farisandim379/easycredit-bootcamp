@model CustomerFormViewModel

<input type="hidden" asp-for="CustomerId" />

<div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3 p-2"></div>

<div class="row g-3">
    <div class="col-12">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" placeholder="Nama sesuai identitas" autocomplete="name" />
        <span asp-validation-for="Name" class="text-danger text-sm font-bold"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Nik" class="form-label"></label>
        <input asp-for="Nik" class="form-control mono" placeholder="16-20 digit angka" inputmode="numeric" />
        <span asp-validation-for="Nik" class="text-danger text-sm font-bold"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" class="form-control" placeholder="08xxxxxxxxxx" autocomplete="tel" />
        <span asp-validation-for="Phone" class="text-danger text-sm font-bold"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" placeholder="nama@email.test" autocomplete="email" />
        <span asp-validation-for="Email" class="text-danger text-sm font-bold"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Address" class="form-label"></label>
        <input asp-for="Address" class="form-control" placeholder="Alamat singkat" autocomplete="street-address" />
        <span asp-validation-for="Address" class="text-danger text-sm font-bold"></span>
    </div>
</div>

<div class="sidebar-note mt-3 p-3" style="border: 2px solid var(--ink); background: var(--paper-light); font-size: 12px;">
    Validasi berjalan di browser (jQuery Validation Unobtrusive) dan diulang di server
    melalui <code>ModelState.IsValid</code>.
</div>
