@model CustomerFormViewModel
@{
    ViewData["Title"] = "Edit Customer";
}

<div class="d-flex flex-column gap-1 mb-4">
    <div class="crumbs mb-1">
        <a asp-controller="Home" asp-action="Index">Dashboard</a>
        <span>/</span>
        <a asp-action="Index">Customer</a>
        <span>/</span>
        <span>Edit</span>
    </div>
    <h2>Edit customer</h2>
    <p class="mb-0" style="opacity: .75; font-size: 13px;">Perbarui data nasabah sesuai identitas terkini.</p>
</div>

<div class="card panel p-4" style="max-width: 800px;">
    <form asp-action="Edit" method="post">
        <partial name="_CustomerForm" model="Model" />

        <div class="d-flex justify-content-end gap-2 mt-4 pt-3" style="border-top: 2px solid var(--ink);">
            <a class="btn btn-action" asp-action="Index">Batal</a>
            <button type="submit" class="btn btn-primary">Simpan perubahan</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
